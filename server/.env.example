# Ollama 本地模型 tag（按 `ollama list` 实际名称修改）
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBED_MODEL=qwen3-embedding:0.6b-q8_0
LLM_TIMEOUT=20
LLM_CONCURRENCY=2
# 本地 Ollama 上下文窗口；36 轮长期总结 prompt 需要 ≥16k
LLM_NUM_CTX=20480

# 可选 OpenAI 兼容后端（缺省用本地 Ollama；同时配好 KEY+BASE_URL 才生效。
# base_url 需以 /v1 结尾，如 https://api.example.com/v1。对话与嵌入都会优先走它，
# 嵌入解析同时兼容 OpenAI {"data":[{"embedding":…}]} 与 Ollama {"embeddings":…}。）
# LLM_API_KEY=
# LLM_API_MODEL=
# API 侧嵌入模型名；留空回退 EMBED_MODEL（嵌入兼容 OpenAI /api/embeddings 两种响应）
# LLM_API_EMBED_MODEL=
# LLM_API_BASE_URL=
# 外接 API 默认直连，不继承 shell 的 http(s)_proxy；必须走代理时改为 true
# LLM_API_TRUST_ENV=false
# 外接 API 单次超时（秒）；失败后仍会重试一次并走模板兜底
# LLM_API_TIMEOUT=8

# M5 每日心事 / 安全日程偏离（默认值如下，一般无需改）
# PLAN_ENABLED=true
# PLAN_DEVIATION_SHIFT_SEC=1200
# PLAN_HEART_MAX_CHARS=60

# 记忆分层：短期 conversation 窗口 10 轮；溢出后生成中期记忆（纯内存，最多 10 条）；
# 每 36 轮原始对话在后台总结成一条长期记忆写入 longterm_memory（不进 Chroma）。
# CONVERSATION_WINDOW_CAPACITY=10
# MIDTERM_CAPACITY=10
# MIDTERM_TOP_K=3
# MIDTERM_MIN_SCORE=0.45
# LONGTERM_TURN_INTERVAL=36

# Langfuse 观测（可选，默认关；不配或不可达也能正常玩，见 docs/DESIGN.md §7.4）
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
